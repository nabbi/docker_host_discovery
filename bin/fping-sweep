#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# fping-sweep — fast ICMP host discovery using fping
# Auto-splits CIDRs larger than /17 to stay within fping's 131072-address limit.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-discover.sh
source "${SCRIPT_DIR}/lib-discover.sh"

parse_args "$@"
resolve_targets

# Default rate: 1000 pps → interval 1ms
interval=1
if [[ -n "$RATE" ]]; then
    if [[ "$RATE" -gt 0 ]]; then
        interval=$(( 1000 / RATE ))
        [[ "$interval" -lt 1 ]] && interval=1
    fi
fi

echo "fping-sweep: scanning ${#TARGETS[@]} target range(s)" >&2

{
    for cidr in "${TARGETS[@]}"; do
        # Split anything larger than /17 into /17 chunks
        while IFS= read -r chunk; do
            echo "  scanning ${chunk}" >&2
            fping -a -q -r 0 -t 100 -B 1 -i "$interval" -g "$chunk" 2>/dev/null || true
        done < <(split_cidr "$cidr" 17)
    done
} | output_results
