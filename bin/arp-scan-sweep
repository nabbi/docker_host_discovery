#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# arp-scan-sweep — L2 ARP host discovery using arp-scan
# Finds all hosts on local subnets via ARP. Cannot be firewalled at L3.
# Requires --net=host and --privileged (raw sockets + host L2 access).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-discover.sh
source "${SCRIPT_DIR}/lib-discover.sh"

parse_args "$@"
resolve_targets

# Default rate: 1000 pps → interval 1ms
interval=1
if [[ -n "$RATE" ]]; then
    if [[ "$RATE" -gt 0 ]]; then
        interval=$(( 1000 / RATE ))
        [[ "$interval" -lt 1 ]] && interval=1
    fi
fi

echo "arp-scan-sweep: scanning ${#TARGETS[@]} target range(s)" >&2

{
    for cidr in "${TARGETS[@]}"; do
        # arp-scan defaults to the first interface it finds, which is wrong for
        # any subnet that isn't on it (Docker bridges, second NICs). Use the
        # interface the kernel routes this subnet through.
        iface_opt=()
        iface="$(route_iface "$cidr")"
        [[ -n "$iface" ]] && iface_opt=(-I "$iface")
        echo "  scanning ${cidr}${iface:+ on ${iface}}" >&2
        run_logged arp-scan -q -r 1 -t 200 -i "$interval" "${iface_opt[@]}" "$cidr" \
            | awk -F'\t' '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/{print $1}'
    done
} | output_results
